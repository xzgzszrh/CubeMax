# 关掉 Node 版本硬校验。
#
# 仓库 engines 声明的是 >=22.20.x <23（因为要用 Node 原生的 .ts 类型剥离，
# 22.18 起默认开启）。更高的大版本同样具备这个能力，但 engines 的上界会把它们
# 一并挡掉，导致 turbo 起不来 —— turbo 会过滤环境变量，命令行上的
# npm_config_engine_strict=false 传不进子进程，所以只能在这里放开。
#
# 注意：这只是不再因为版本不符而拒绝执行，并不保证任意版本都能跑。
# 低于 22.18 的 Node 没有类型剥离，仍然会在加载 @buildingai/*/shared/*.ts 时报错。
engine-strict=false
strict-peer-dependencies=false
shell-emulator=true
registry=https://registry.npmmirror.com
prefer-workspace-packages = true
