{
    "name": "@buildingai/mcp-server",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check-types": "tsc -p tsconfig.json --noEmit",
        "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('.turbo',{recursive:true,force:true});try{require('fs').rmSync('tsconfig.tsbuildinfo',{force:true})}catch(e){}\"",
        "dev": "tsx watch --env-file=.env src/index.ts",
        "start": "node --env-file=.env dist/index.js"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "1.27.1",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "catalog:dev",
        "tsx": "^4.20.3",
        "typescript": "catalog:dev"
    },
    "engines": {
        "node": ">=22.20.x <23"
    }
}
